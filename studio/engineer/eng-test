#!/usr/bin/env python3
"""eng-test ACTION.py TEST_SCENE.json  -- render a short test scene with a draft plug-in action, off air.

TEST_SCENE.json: {"seconds": 3-8, "cast": ["biscuit", "pip"], "backdrop"?: name, "timeline": [... events ...]}
(cast is a list of puppet names; looks, voices and positions are filled in as on air)

Writes next to ACTION.py: review.jpg (6 frames, left to right, top to bottom, times printed), frames/t*.jpg, test.mp4,
and copies the scene to test_scene.json. Prints plug-in errors from the render log. Runs as you, never as root.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

B = Path("/hyperai/home/kids-test/blender")
sys.path.insert(0, str(B))


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    action, scene_path = Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()
    out = action.parent
    from producer_loop import CAST, SPOTS, SCENE_DEFAULTS
    sc = json.loads(scene_path.read_text())
    names = sc.get("cast") or []
    if isinstance(names, dict):
        names = list(names)
    names = [n for n in names if n in CAST][:3]
    if not names:
        sys.exit("cast must list 1-3 of: " + ", ".join(CAST))
    seconds = min(max(float(sc.get("seconds", 6)), 2), 8)
    scene = {**SCENE_DEFAULTS, "seconds": seconds, "title": "engineer test", "resolution": [640, 360], "samples": 4,
             "cast": {n: {**{k: v for k, v in CAST[n].items() if k != "about"}, "at": list(at)}
                      for n, at in zip(names, SPOTS[len(names)])},
             "timeline": sc.get("timeline", [])}
    if sc.get("backdrop"):
        img = Path("/hyperai/home/loop/puddle/library/images") / f"{sc['backdrop']}.png"
        if img.exists():
            scene["backdrop_path"] = str(img)
    shutil.copy(scene_path, out / "test_scene.json") if scene_path != out / "test_scene.json" else None

    work = Path(tempfile.mkdtemp(prefix="engtest_", dir=str(out)))
    plug = work / "plugins"
    plug.mkdir()
    shutil.copy(action, plug / action.name)
    (work / "scene.json").write_text(json.dumps(scene))
    t0 = time.time()
    r = subprocess.run([sys.executable, str(B / "voice.py"), str(work / "scene.json"), str(work)], capture_output=True, text=True)
    if r.returncode:
        sys.exit("voice step failed (check say events):\n" + r.stderr[-1500:])
    env = {**os.environ, "PUDDLE_ACTIONS": str(plug)}
    try:
        r = subprocess.run(["/hyperai/home/bl.sh", "-b", "--python", str(B / "puddle.py"), "--", str(work / "scene.voiced.json"),
                            str(work)], capture_output=True, text=True, env=env, timeout=480)
    except subprocess.TimeoutExpired:
        sys.exit("render took over 8 minutes: the GPU may be very busy, or the action loops forever or makes far too many objects")
    log = r.stdout + r.stderr
    problems = [l for l in log.splitlines() if "PLUGIN" in l or "Error" in l or "Traceback" in l or "unknown action" in l]
    frames = sorted((work / "frames").glob("*")) if (work / "frames").exists() else []
    if r.returncode or not frames:
        print("RENDER FAILED. Last lines of the Blender log:")
        print("\n".join(log.splitlines()[-25:]))
        sys.exit(1)
    fps, step = scene["fps"], scene["step"]
    clip = out / "test.mp4"
    subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-framerate", str(fps / step), "-pattern_type", "glob",
                    "-i", str(work / "frames" / f"*{frames[0].suffix}"), "-i", str(work / "voices.wav"), "-vf", "fps=24,format=yuv420p",
                    "-shortest", str(clip)], check=True)
    fdir = out / "frames"
    shutil.rmtree(fdir, ignore_errors=True)
    fdir.mkdir()
    times = sc.get("check_times") or [round(seconds * i / 6 + seconds / 12, 2) for i in range(6)]
    times = [min(max(float(t), 0), seconds - 0.05) for t in times][:6]
    paths = []
    for t in times:
        p = fdir / f"t{t:05.2f}.jpg"
        subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-ss", str(t), "-i", str(clip), "-frames:v", "1",
                        "-vf", f"scale=640:-1:flags=lanczos,drawtext=text='t={t:.2f}s':x=10:y=10:fontsize=28:fontcolor=white:box=1:boxcolor=black@0.5",
                        str(p)], check=True)
        paths.append(p)
    while len(paths) < 6:
        paths.append(paths[-1])
    inputs = sum((["-i", str(p)] for p in paths), [])
    subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", *inputs, "-filter_complex",
                    "[0][1][2]hstack=3[a];[3][4][5]hstack=3[b];[a][b]vstack", str(out / "review.jpg")], check=True)
    # a smaller copy for the model to look at: images cost model memory
    subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", str(out / "review.jpg"), "-vf", "scale=960:-1",
                    str(out / "review_small.jpg")], check=True)
    shutil.rmtree(work, ignore_errors=True)
    print(f"rendered {seconds:.0f}s test in {time.time() - t0:.0f}s")
    if problems:
        print("PROBLEMS in the render log (fix these):")
        print("\n".join(problems[:20]))
    else:
        print("no plug-in errors in the render log")
    print("review sheet:", out / "review.jpg", "(6 frames, times printed on each)")
    for p in paths[:len(times)]:
        print("frame:", p)


if __name__ == "__main__":
    main()
