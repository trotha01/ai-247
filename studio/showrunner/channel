    if "--text" in args:
        i = args.index("--text")
        text = args[i + 1]
        args = args[:i] + args[i + 2:]
    kind, name, prompt = args[0], args[1], " ".join(args[2:])
    got = lib().request(name, kind, prompt, text=text)
    print(f"ordered {kind} {got}; MOSS makes it between blocks (a window opens at most every 10 minutes)" if got
          else "not ordered: need kind backdrop|card, a name, a prompt, and --text for cards")


def logs(args):
    which = args[0] if args else "worker"
    n = int(args[1]) if len(args) > 1 else 20
