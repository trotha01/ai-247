SOCK = "/hyperai/home/loop/channel.sock"
PROPOSALS = ROOT / "proposals"
ACTIONS_LIVE = ROOT / "actions" / "live"
BUILTIN_ACTIONS = {"shot", "say", "hop", "move", "wave", "point", "look", "spawn", "bounce", "eat", "numeral"}
# who may run what through the service (root runs anything directly on the box)
READ = {"status", "recent", "scene", "frames", "notes", "brief", "library", "logs", "proposals", "actions"}
ALLOWED = {
    "show": READ | {"direct", "unnote", "order", "restart", "propose"},
    "eng": READ | {"submit"},
    "gate": {"notes", "recent", "proposals"},
}
sys.path.insert(0, "/hyperai/home/kids-test/blender")


def sh(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()


def fetch(url) -> bytes:
    """curl, not urllib: the box's resolver returns a bad IPv4 address for workers.dev and only curl gets through."""
    r = subprocess.run(["curl", "-sf", "-m", "30", "--retry", "5", "--retry-all-errors", "--retry-delay", "1", url], capture_output=True)
    if r.returncode:
        raise RuntimeError(f"could not fetch {url} (curl exit {r.returncode})")
    return r.stdout


def running(pattern):
    return bool(sh(f"pgrep -f {pattern}"))


def lib():
    import backdrops
    return backdrops.Library(ROOT / "library")


def status(_):
    print(f"producer: {'running' if running('producer_loop.py') else 'STOPPED'}   "
          f"worker: {'running' if running('channel_worker.py') else 'STOPPED'}   "
          f"llama-server (Qwen): {'running' if running('llama-server') else 'STOPPED'}")
    if (ROOT / "STOP").exists():
        print("STOP file present: both loops are told to stop")
    lines = [l for l in (ROOT / "worker.log").read_text().splitlines() if "ON AIR" in l]
    if lines:
        print("last block on air:", lines[-1][:120])
        recent = lines[-10:]
        mins = sum(float(l.split(" scenes, ")[1].split(" min")[0]) for l in recent if " scenes, " in l)
        t0, t1 = recent[0][:8], recent[-1][:8]
        span = (time.mktime(time.strptime(t1, "%H:%M:%S")) - time.mktime(time.strptime(t0, "%H:%M:%S"))) % 86400
        if span > 0 and len(recent) > 1:
            fresh = sum(float(l.split(" scenes, ")[1].split(" min")[0]) for l in recent[1:])
            print(f"production speed over the last {len(recent)} blocks: {fresh * 60 / span:.2f}x real time "
                  f"(below 1.0 means viewers see some replays)")
    fails = [l for l in (ROOT / "worker.log").read_text().splitlines()[-200:] if "FAILED" in l]
    print(f"scenes queued: {len(list((ROOT / 'inbox').glob('*.json')))}   failed scenes (total): "
          f"{len(list((ROOT / 'failed').glob('*.json')))}   recent failures in log: {len(fails)}")
    L = lib()
    print(f"image library: {len(L.ready('backdrop'))} backdrops, {len(L.ready('card'))} cards ready, {len(L.pending())} being made")
    print("GPU:", sh("nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader"),
          "  RAM:", sh("free -g | awk 'NR==2{print $3\"/\"$2\" GB used\"}'"))
    try:
        h = json.loads(fetch(STREAM + "/healthz"))
        print(f"stream: ok={h.get('ok')} source={h.get('source')} manifest age {h.get('manifest', {}).get('age_s')}s")
    except Exception as e:
        print("stream health check failed:", e)


