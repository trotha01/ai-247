def scene(args):
    files = sorted(list((ROOT / "done").glob("*.json")) + list((ROOT / "inbox").glob("*.json")), key=lambda p: p.stat().st_mtime)
    if args and args[0] != "last":
        files = [f for f in files if args[0] in f.name]
    if not files:
        sys.exit("no such scene")
    f = files[-1]
    d = json.loads(f.read_text())
    print(f.name)
    print(json.dumps({k: d[k] for k in ("title", "segment", "backdrop", "card") if k in d}))
    print("cast:", ", ".join(d["cast"]))
    for e in d["timeline"]:
        rest = {k: v for k, v in e.items() if k not in ("t", "do")}
        print(f"  {e['t']:5.1f}  {e['do']:8} {json.dumps(rest)}")


def r2():
    """boto3 client for the channel's R2 bucket (keys from the root-only .r2.env)."""
    import boto3
    env = dict(l.split("=", 1) for l in Path("/hyperai/home/.r2.env").read_text().split() if "=" in l)
    c = boto3.client("s3", endpoint_url=f"https://{env['R2_ACCOUNT_ID']}.r2.cloudflarestorage.com",
                     aws_access_key_id=env["R2_ACCESS_KEY_ID"], aws_secret_access_key=env["R2_SECRET_ACCESS_KEY"],
                     region_name="auto")
    return c, env["R2_BUCKET"]


def frames(args):
    """Frames of the segments on air right now, found exactly as the Worker finds them, read straight from R2."""
    n = int(args[0]) if args else 4
    sys.path.insert(0, "/hyperai/home/ai-247")
    from newsbot import channel as ch
    c, bucket = r2()
    m = json.loads(c.get_object(Bucket=bucket, Key="puddle/manifest.json")["Body"].read())
    k = ch.live_k(time.time())
    out = ROOT / "frames"
    out.mkdir(exist_ok=True)
    ts = time.strftime("%Y%m%d-%H%M%S")
    paths = []
    for i in range(n):
        uri = ch.segment_at(m, k + i)["uri"]
        tmp = Path(f"/tmp/sr_{i}.ts")
        c.download_file(bucket, "puddle/" + uri, str(tmp))
        p = out / f"{ts}_{i}.jpg"
        subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-ss", "3", "-i", str(tmp), "-frames:v", "1",
                        "-vf", "scale=960:-1", str(p)], check=True)
        paths.append(p)
    for old in sorted(out.glob("*.jpg"))[:-40]:
        old.unlink()
    print(f"frames from what is on air now, about 6 s apart (segment {k} onward):")
    for p in paths:
        print(" ", p)


def direct(args):
    text = " ".join(args).strip()
    if not text:
        sys.exit('usage: channel direct "TEXT"')
    d = P / "directions"
    d.mkdir(parents=True, exist_ok=True)
    (d / f"{int(time.time() * 1000)}.md").write_text(text + "\n")
    print("sent; the producer adds it to the standing directions within a few seconds")


