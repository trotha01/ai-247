def restart(args):
    which = args[0]
    if which not in ("producer", "worker"):
        sys.exit("restart producer|worker")
    pat = {"producer": "producer_loop.py", "worker": "channel_worker.py"}[which]
    sh(f"pkill -f {pat}")
    time.sleep(2)
    extra = " --block 4 --renders 4" if which == "worker" else ""
    print(sh(f"{LOOP}/run_{which}.sh{extra}"))



def _slug(s, n=30):
    import re
    return re.sub(r"[^a-z0-9]+", "_", s.lower()).strip("_")[:n] or "x"


def _load(pid):
    f = PROPOSALS / pid / "request.json"
    if not f.exists():
        sys.exit(f"no proposal {pid}")
    return json.loads(f.read_text())


def _save(d, event):
    d.setdefault("history", []).append(f"{time.strftime('%Y-%m-%d %H:%M')} {event}")
    f = PROPOSALS / d["id"] / "request.json"
    tmp = f.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=1))
    tmp.rename(f)


def action_meta(path):
    """ACTION, DESCRIPTION, NEEDS, PARAMS of a plug-in, read with ast: never imported or run here."""
    import ast
    tree = ast.parse(Path(path).read_text())
    meta = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            if node.targets[0].id in ("ACTION", "DESCRIPTION", "NEEDS", "PARAMS"):
                meta[node.targets[0].id] = ast.literal_eval(node.value)
    has_run = any(isinstance(n, ast.FunctionDef) and n.name == "run" for n in tree.body)
    return meta, has_run


def propose(args):
    if len(args) < 2:
        sys.exit('usage: channel propose "TITLE" "WHAT IT SHOULD DO"')
    title, what = args[0].strip()[:120], " ".join(args[1:]).strip()[:2000]
    pid = time.strftime("%Y%m%d-%H%M%S") + "-" + _slug(title)
    (PROPOSALS / pid).mkdir(parents=True, exist_ok=True)
    _save({"id": pid, "title": title, "what": what, "status": "new", "created": time.time()}, "filed")
    print(f"filed {pid}: the engineer picks it up within a minute; the owners approve it before it airs")


def proposals(args):
    items = sorted(PROPOSALS.glob("*/request.json"))[-15:] if PROPOSALS.exists() else []
    if not items:
        print("(no requests)")
    for f in items:
        d = json.loads(f.read_text())
        extra = ""
        if d["status"] in ("ready", "live"):
            extra = f"  action: {d.get('action')}  preview: {f.parent / 'review.jpg'}"
        if d.get("reason"):
            extra += f"  ({d['reason'][:160]})"
        print(f"- [{d['status']}] {d['id']}: {d['title']}{extra}")


def actions(args):
    files = sorted(ACTIONS_LIVE.glob("*.py")) if ACTIONS_LIVE.exists() else []
    if not files:
        print("(no plug-in actions yet)")
    for f in files:
        meta, _ = action_meta(f)
        print(f"- {meta.get('PARAMS', meta.get('ACTION'))}: {meta.get('DESCRIPTION', '')}")


def submit(args):
    pid, src = args[0], Path(args[1])
    eng_root = Path("/output/eng/work").resolve()

    def inside(f):  # a real file inside the engineer's work folder: no links, nothing else on the machine
        return f.exists() and not f.is_symlink() and f.is_file() and eng_root in f.resolve().parents

    if not inside(src):
        sys.exit(f"not submitted: {src} must be a file in {eng_root}")
    d = _load(pid)
    if d["status"] not in ("building", "new", "rejected", "failed"):
        sys.exit(f"{pid} is {d['status']}, not open for submission")
    meta, has_run = action_meta(src)
    missing = [k for k in ("ACTION", "DESCRIPTION", "NEEDS", "PARAMS") if k not in meta] + ([] if has_run else ["run()"])
    if missing:
        sys.exit("not submitted, the file is missing: " + ", ".join(missing))
    name = meta["ACTION"]
    if name != _slug(name) or name in BUILTIN_ACTIONS:
        sys.exit(f"not submitted: ACTION must be a new lowercase_name, not {name!r}")
    grid = src.parent / "review.jpg"
    if not inside(grid):
        sys.exit(f"not submitted: run eng-test first; it leaves review.jpg next to {src.name}")
    dst = PROPOSALS / pid
    shutil.copy(src, dst / "action.py")
    shutil.copy(grid, dst / "review.jpg")
    for extra in ("test_scene.json", "notes.md"):
        if inside(src.parent / extra):
            shutil.copy(src.parent / extra, dst / extra)
    d.update(status="ready", action=name, reason=None)
    _save(d, f"submitted action {name}")
    print(f"submitted {name}: waiting for an owner to approve. Preview: {dst / 'review.jpg'}")


def approve(args):
    d = _load(args[0])
    if d["status"] != "ready":
        sys.exit(f"{d['id']} is {d['status']}, not ready")
    ACTIONS_LIVE.mkdir(parents=True, exist_ok=True)
    shutil.copy(PROPOSALS / d["id"] / "action.py", ACTIONS_LIVE / f"{d['action']}.py")
    d["status"] = "live"
    _save(d, "approved by owner")
    print(f"{d['action']} is live: the producer can use it from its next scene")


def reject(args):
    d = _load(args[0])
    d.update(status="rejected", reason=" ".join(args[1:]) or "rejected by owner")
    _save(d, "rejected: " + d["reason"])
    print(f"rejected {d['id']}")


def retire(args):
    f = ACTIONS_LIVE / f"{_slug(args[0])}.py"
    if not f.exists():
        sys.exit(f"no live action {args[0]}")
    f.unlink()
    print(f"retired {args[0]}: the producer stops using it from its next scene")


CMDS = {"status": status, "recent": recent, "scene": scene, "frames": frames, "direct": direct, "notes": notes,
        "unnote": unnote, "brief": brief, "library": library, "order": order, "logs": logs, "restart": restart,
        "propose": propose, "proposals": proposals, "actions": actions, "submit": submit, "approve": approve,
        "reject": reject, "retire": retire}

class _ThreadOut:
    """sys.stdout that writes to the calling thread's buffer, so parallel requests do not mix their output."""
    def __init__(self, real):
        import threading
        self.real, self.local = real, threading.local()

    def write(self, s):
        return (getattr(self.local, "buf", None) or self.real).write(s)

    def flush(self):
        (getattr(self.local, "buf", None) or self.real).flush()


def run_local(argv) -> tuple[int, str]:
    """Run one command in this process, capturing its output (per thread)."""
    if not isinstance(sys.stdout, _ThreadOut):
        sys.stdout = _ThreadOut(sys.stdout)
    buf = io.StringIO()
    sys.stdout.local.buf = buf
    code = 0
    try:
        CMDS[argv[0]](argv[1:])
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else 1
        if isinstance(e.code, str):
            print(e.code)
    except Exception as e:
        code = 1
        print(f"error: {e!r}")
    finally:
        sys.stdout.local.buf = None
    return code, buf.getvalue()


def handle(conn):
    """One request on its own thread: a slow command (frames) never blocks the others, and a client that hangs up
    (the studio page gives up after 20 s) only ends its own request."""
    with conn:
        try:
            data = b""
            while not data.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    return
                data += chunk
            argv = json.loads(data)["argv"]
            uid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))[1]
            try:
                who = pwd.getpwuid(uid).pw_name
            except KeyError:
                who = str(uid)
            if not argv or argv[0] not in CMDS or argv[0] == "serve" or not all(isinstance(a, str) for a in argv):
                code, out = 1, __doc__
            elif argv[0] not in ALLOWED.get(who, set()):
                code, out = 1, f"'{argv[0]}' is not available to {who}\n"
            else:
                with RUN_LOCK if argv[0] in ("restart", "frames", "order", "direct", "unnote") else NO_LOCK:
                    code, out = run_local(argv)
            print(time.strftime("%H:%M:%S"), who, "channel", " ".join(argv)[:200], "->", code, flush=True)
            conn.sendall(json.dumps({"code": code, "out": out}).encode())
        except Exception as e:
            print(time.strftime("%H:%M:%S"), "request dropped:", repr(e)[:200], flush=True)


def serve(_):
    """Root-side service: one JSON request {argv} per connection, answers {code, out}. Threads per request."""
    import threading
    global RUN_LOCK, NO_LOCK
    RUN_LOCK, NO_LOCK = threading.Lock(), contextlib.nullcontext()
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)
    srv.listen(32)
    print("channel service on", SOCK, flush=True)
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle, args=(conn,), daemon=True).start()


def via_service(argv):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(300)
    try:
        s.connect(SOCK)
    except OSError:
        sys.exit("the channel service is not running (an admin starts it with: channel serve)")
    s.sendall(json.dumps({"argv": argv}).encode() + b"\n")
    data = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        data += chunk
    r = json.loads(data)
    print(r["out"], end="")
    sys.exit(r["code"])


CMDS["serve"] = serve

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print(__doc__)
        sys.exit(0 if len(sys.argv) < 2 else 1)
    if os.geteuid() != 0:
        via_service(sys.argv[1:])
    CMDS[sys.argv[1]](sys.argv[2:])
