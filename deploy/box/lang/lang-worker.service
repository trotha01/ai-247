# systemd USER unit template (deploy/box/install.sh replaces @ROOT@). Renders lessons and publishes them under lang/.
[Unit]
Description=Language channel worker (render lessons, publish 1-lesson blocks to ai247-media lang/)
After=lang-producer.service

[Service]
WorkingDirectory=@ROOT@/src/ai-247
EnvironmentFile=@ROOT@/lang/env
EnvironmentFile=@ROOT@/lang/r2.env
ExecStart=@ROOT@/venv/bin/python -u -m lang.channel_worker --root @ROOT@/lang/run --prefix lang/ --block 1 --max-wait 120 --local-cap-gb 3
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
