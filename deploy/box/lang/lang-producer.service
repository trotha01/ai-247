# systemd USER unit template (deploy/box/install.sh replaces @ROOT@). Keeps lesson scripts queued ahead of the worker.
[Unit]
Description=Language channel producer (lesson scripts queued ahead of the worker)

[Service]
WorkingDirectory=@ROOT@/src/ai-247
EnvironmentFile=@ROOT@/lang/env
ExecStart=@ROOT@/venv/bin/python -u -m lang.producer_loop --root @ROOT@/lang/run --target 12
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
